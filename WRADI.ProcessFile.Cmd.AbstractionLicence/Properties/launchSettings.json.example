{
  "$schema": "http://json.schemastore.org/launchsettings.json",
  "profiles": {
    "WaterAbstractionLicenseExtractor.Cmd": {
      "commandName": "Project",
      "environmentVariables": {
        "TESSDATA_PREFIX": "../../../../WALE.ProcessFile.Services/tessdata",
        "AzureAIVisionEndpoint": "[FILLIN]",
        "AzureAIVisionKey": "[FILLIN]",
        "PdfFolderPath": "../../../../../WaterPdfs/",
        "ReportTemplatePath": "../../../../WALE.ProcessFile.Services/Templates/",
        "FileMappingPath": "../../../../licence-number-filename-map.csv",
        "OutputFolder": "Output/",
        "CacheFolder": "Cache/",
        "AwsS3AccessKey": "",
        "AwsS3SecretKey": "",
        "AwsRegionName": "eu-west-1",
        "AwsS3BucketName": "",        
        "ConcurrentCount": "10",
        "REGENERATE_MAPPING_JSON": "true",
        "LOAD_AI_JS": "false",
        "RefreshCache": "false",
        "ListDataPath": "list-data.js",
        "ProcessRunsDataPath": "",
        "InternalDataPath": "filename + '/internal.jsonp'",
        "LicenceDataPath": "filename + '/licence.jsonp'",
        "LicenceSetsDataPath": "filename + '/licence-sets.jsonp'",
        "ThumbnailImageDataPath": "''",
        "FullImageDataPath": "''",
        "DotnetPath": "/usr/local/share/dotnet/dotnet",
        "TesseractExeName": "WALE.ProcessFile.Services.TesseractExe.dll",
        "TesseractExeDirectory": "[Fill in]",
        "ApiBaseUrl": ""
      }
    }
  }
}