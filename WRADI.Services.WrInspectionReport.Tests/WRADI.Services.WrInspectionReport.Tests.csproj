<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <UserSecretsId>35a2de0c-7d9c-4757-bd8f-e698031d9caa</UserSecretsId>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="coverlet.collector" Version="6.0.0" />
        <PackageReference Include="FakeItEasy" Version="9.0.1" />
        <PackageReference Include="Meziantou.Xunit.ParallelTestFramework" Version="2.3.0" />
        <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.9" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
        <PackageReference Include="xunit" Version="2.5.3" />
        <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="Xunit" />
    </ItemGroup>

    <!-- PDFClown.NET's ContentScanner uses System.Drawing.Matrix/PointF for CTM math, which
         .NET 6+ blocks outright on non-Windows unless explicitly opted back in - libgdiplus
         alone (see link_deps below) isn't enough. -->
    <ItemGroup>
        <RuntimeHostConfigurationOption Include="System.Drawing.EnableUnixSupport" Value="true" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\WALE.ProcessFile.Services\WALE.ProcessFile.Services.csproj" />
        <ProjectReference Include="..\WALE.ProcessFile.Services.AzureAiServicesDocumentIntelligence\WALE.ProcessFile.Services.AzureAiServicesDocumentIntelligence.csproj" />
        <ProjectReference Include="..\WRADI.Services.WrInspectionReport\WRADI.Services.WrInspectionReport.csproj" />
        <ProjectReference Include="..\WALE.ProcessFile.Services.Tabula\WALE.ProcessFile.Services.Tabula.csproj" />
        <ProjectReference Include="..\WALE.ProcessFile.Services.PdfClown\WALE.ProcessFile.Services.PdfClown.csproj" />
        <ProjectReference Include="..\WRADI.Services.ProcessFile.WrInspectionReport\WRADI.Services.ProcessFile.WrInspectionReport.csproj" />
    </ItemGroup>

    <Target Name="link_deps" AfterTargets="AfterBuild" Condition=" '$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::OSX)))' ">
        <Exec Command="ln -sf /opt/homebrew/lib/libleptonica.dylib $(OutDir)x64/libleptonica-1.82.0.dylib" />
        <Exec Command="ln -sf /opt/homebrew/lib/libtesseract.dylib $(OutDir)x64/libtesseract50.dylib" />
        <!-- System.Drawing.Common (needed by PDFClown.NET's ContentScanner) needs libgdiplus,
             which isn't bundled for macOS - brew install mono-libgdiplus, then symlink it where
             dyld actually looks. -->
        <MakeDir Directories="$(OutDir)runtimes/osx-arm64/native" />
        <Exec Command="ln -sf /opt/homebrew/lib/libgdiplus.dylib $(OutDir)runtimes/osx-arm64/native/libgdiplus.dll.dylib" />
        <Exec Command="ln -sf /opt/homebrew/lib/libgdiplus.dylib $(OutDir)runtimes/osx-arm64/native/libgdiplus.dll" />
        <Exec Command="ln -sf /opt/homebrew/lib/libgdiplus.dylib $(OutDir)runtimes/osx-arm64/native/libgdiplus.dylib" />
    </Target>
</Project>
